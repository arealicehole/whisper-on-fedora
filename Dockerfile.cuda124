# Dockerfile for Whisper API with CUDA 12.4 and cuDNN 8.x
# This configuration works with Blackwell GPUs by using compatible cuDNN version

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

# Install Python and system dependencies
RUN apt-get update && apt-get install -y \
    python3.11 \
    python3.11-dev \
    python3-pip \
    ffmpeg \
    git \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Set Python 3.11 as default
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# Upgrade pip
RUN python -m pip install --upgrade pip

# Install PyTorch with CUDA 12.4 support
# Using specific version that works with CUDA 12.4
RUN pip install torch==2.5.1 torchvision==0.20.1 torchaudio==2.5.1 --index-url https://download.pytorch.org/whl/cu124

# Install faster-whisper and dependencies
RUN pip install \
    faster-whisper==1.0.3 \
    ctranslate2==4.4.0 \
    fastapi==0.110.0 \
    uvicorn[standard]==0.27.0 \
    python-multipart==0.0.9 \
    httpx==0.27.0 \
    pydantic==2.6.0 \
    numpy==1.26.4 \
    soundfile==0.12.1 \
    librosa==0.10.1 \
    scipy==1.12.0

# Create app directory
WORKDIR /app

# Copy application files
COPY main.py gpu_validator.py ./
COPY startup.py ./

# Create volume mount points
VOLUME ["/app/models", "/app/config", "/app/audio_files"]

# Environment variables for GPU optimization
ENV CUDA_VISIBLE_DEVICES=0
ENV PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512
ENV OMP_NUM_THREADS=8

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; r = requests.get('http://localhost:8767/health'); exit(0 if r.json().get('ok') else 1)"

# Expose port
EXPOSE 8767

# Run the application
CMD ["python", "main.py"]