# Systemd service file for Whisper API
# Install with: sudo cp whisper-api.service /etc/systemd/system/
# Enable with: sudo systemctl enable whisper-api
# Start with: sudo systemctl start whisper-api

[Unit]
Description=Whisper API with Optional Diarization
After=network.target

[Service]
Type=simple
User=ice
WorkingDirectory=/home/ice/whisper-api

# Environment variables
Environment="WHISPER_MODEL=small"
Environment="WHISPER_DEVICE=cuda"
Environment="WHISPER_COMPUTE=float16"
Environment="WHISPER_DIARIZE=true"
Environment="PATH=/home/ice/.venvs/whisper-diarize/bin:/usr/local/bin:/usr/bin:/bin"

# Start command - uses the virtual environment directly
ExecStart=/home/ice/.venvs/whisper-diarize/bin/python /home/ice/whisper-api/main.py

# Restart policy
Restart=on-failure
RestartSec=10

# Logging
StandardOutput=append:/home/ice/.whisper-api.log
StandardError=append:/home/ice/.whisper-api.log

[Install]
WantedBy=multi-user.target