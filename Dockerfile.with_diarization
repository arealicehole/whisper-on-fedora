# Working Dockerfile for Whisper API with CUDA 12.4 AND Diarization
# Tested for Blackwell GPU with PyAnnote support

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    ffmpeg \
    wget \
    git \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python3 -m pip install --upgrade pip

# Install PyTorch with CUDA 12.4 support (specific version that works)
RUN pip3 install torch==2.5.1 torchvision==0.20.1 torchaudio==2.5.1 --index-url https://download.pytorch.org/whl/cu124

# Install faster-whisper and dependencies
RUN pip3 install \
    faster-whisper==1.0.3 \
    ctranslate2==4.4.0 \
    fastapi==0.110.0 \
    uvicorn[standard]==0.27.0 \
    python-multipart==0.0.9 \
    httpx==0.27.0 \
    pydantic==2.6.0 \
    numpy==1.26.4 \
    soundfile \
    librosa \
    scipy

# Install PyAnnote for diarization
# Install dependencies first to avoid conflicts
RUN pip3 install \
    asteroid-filterbanks>=0.4.0 \
    einops>=0.6.0 \
    hbreader>=0.9.1 \
    hyperpyyaml>=1.2.0 \
    julius>=0.2.7 \
    omegaconf>=2.3.0 \
    pyannote.core>=5.0.0 \
    pyannote.database>=5.0.0 \
    pyannote.metrics>=3.2.0 \
    pyannote.pipeline>=3.0.0 \
    pytorch-lightning>=2.0.0 \
    pytorch-metric-learning>=2.3.0 \
    rich>=13.0.0 \
    semver>=3.0.0 \
    sentencepiece>=0.1.97 \
    speechbrain>=1.0.0 \
    torchmetrics>=0.11.0 \
    transformers>=4.44.0 \
    torch-audiomentations>=0.11.0 \
    huggingface-hub>=0.19.0

# Install PyAnnote audio (may need --no-deps to avoid version conflicts)
RUN pip3 install pyannote.audio

# Set working directory
WORKDIR /app

# Copy application files
COPY main_docker_diarization.py main.py
COPY gpu_validator.py ./

# Create directories for models and cache
RUN mkdir -p /app/models /app/config /app/audio_files /root/.cache/huggingface

# Environment variables
ENV NVIDIA_VISIBLE_DEVICES=0
ENV CUDA_VISIBLE_DEVICES=0
ENV PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512
ENV HF_HOME=/root/.cache/huggingface

# Expose port
EXPOSE 8767

# Run the application
CMD ["python3", "main.py"]