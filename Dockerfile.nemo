# NeMo Diarization Dockerfile for Whisper API with CUDA 12.4
# Optimized for Blackwell GPU (RTX 5060 Ti) with NeMo support

FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    ffmpeg \
    wget \
    git \
    libsndfile1 \
    sox \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN python3 -m pip install --upgrade pip

# Install PyTorch with CUDA 12.4 support
RUN pip3 install torch==2.5.1 torchvision==0.20.1 torchaudio==2.5.1 --index-url https://download.pytorch.org/whl/cu124

# Install faster-whisper and dependencies
RUN pip3 install \
    faster-whisper==1.0.3 \
    ctranslate2==4.4.0 \
    fastapi==0.110.0 \
    uvicorn[standard]==0.27.0 \
    python-multipart==0.0.9 \
    httpx==0.27.0 \
    pydantic==2.6.0 \
    numpy==1.26.4 \
    soundfile \
    librosa \
    scipy

# Install dependencies for NeMo
RUN pip3 install \
    omegaconf==2.3.0 \
    hydra-core==1.3.2 \
    pytorch-lightning==2.1.0 \
    transformers==4.36.0 \
    webdataset==0.2.86 \
    pandas \
    scikit-learn \
    matplotlib

# Install NeMo toolkit with ASR capabilities
# Using specific version for stability
RUN pip3 install nemo_toolkit[asr]==2.0.0

# Set working directory
WORKDIR /app

# Copy application files
COPY main_nemo.py main.py
COPY gpu_validator.py ./
COPY nemo_diarizer.py ./

# Create directories for models, configs and cache
RUN mkdir -p /app/models /app/configs /app/audio_files /app/nemo_outputs \
    /root/.cache/huggingface /root/.cache/torch

# Copy configuration files
COPY configs/diar_infer_inference.yaml /app/configs/

# Environment variables for GPU and NeMo
ENV NVIDIA_VISIBLE_DEVICES=0
ENV CUDA_VISIBLE_DEVICES=0
ENV PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512
ENV HF_HOME=/root/.cache/huggingface
ENV TORCH_HOME=/root/.cache/torch
ENV NUMBA_CACHE_DIR=/tmp/numba_cache

# Blackwell GPU optimizations
ENV TORCH_CUDA_ARCH_LIST="8.0;8.6;8.9;9.0;12.0"
ENV CUDA_LAUNCH_BLOCKING=1

# Expose port
EXPOSE 8767

# Run the application
CMD ["python3", "main.py"]