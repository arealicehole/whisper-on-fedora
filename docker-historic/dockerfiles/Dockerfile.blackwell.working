# Use standard CUDA base image that works with Blackwell
FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu22.04

# Set working directory
WORKDIR /app

# Install system dependencies and Python
RUN apt-get update && apt-get install -y \
    python3.11 \
    python3.11-dev \
    python3.11-venv \
    python3-pip \
    ffmpeg \
    git \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Set Python 3.11 as default
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# Upgrade pip
RUN python -m pip install --upgrade pip setuptools wheel

# Install PyTorch nightly with CUDA 12.6 support for Blackwell
# This version should include sm_120 support
RUN pip install --no-cache-dir \
    --index-url https://download.pytorch.org/whl/nightly/cu126 \
    torch torchvision torchaudio

# Install application dependencies
RUN pip install --no-cache-dir \
    fastapi==0.115.5 \
    uvicorn[standard]==0.32.1 \
    python-multipart==0.0.18 \
    httpx==0.28.0 \
    python-dotenv==1.0.1 \
    aiofiles \
    pydantic \
    numpy \
    scipy

# Install faster-whisper for GPU transcription
RUN pip install --no-cache-dir faster-whisper==1.0.3

# Install audio processing
RUN pip install --no-cache-dir \
    soundfile==0.12.1 \
    librosa==0.10.2.post1

# Install minimal pyannote dependencies
RUN pip install --no-cache-dir \
    einops>=0.6.0 \
    omegaconf>=2.1 \
    huggingface-hub>=0.24.0 \
    scikit-learn>=1.3.0 \
    pyannote.core>=5.0 \
    pyannote.metrics>=3.2

# Install pyannote.audio without torch dependency
RUN pip install --no-cache-dir --no-deps pyannote.audio==3.1.1

# Install speechbrain without dependencies
RUN pip install --no-cache-dir --no-deps speechbrain==1.0.0

# Copy application files
COPY main.py /app/
COPY diarization_handler.py /app/
COPY whisper_client.py /app/

# Create necessary directories
RUN mkdir -p /root/.config/whisper \
    /root/.cache/huggingface \
    /root/.cache/whisper \
    /app/audio_files

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV CUDA_VISIBLE_DEVICES=0
ENV TORCH_CUDA_ARCH_LIST="12.0"
ENV WHISPER_DEVICE="cuda"
ENV WHISPER_COMPUTE="float16"
ENV PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"

# Expose API port
EXPOSE 8765

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8765/health || exit 1

# Runtime GPU verification and start API
CMD python -c "import torch; print('========================================'); print('PyTorch:', torch.__version__); print('CUDA Available:', torch.cuda.is_available()); gpu = torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'No GPU'; print('GPU:', gpu); print('========================================');" && python main.py