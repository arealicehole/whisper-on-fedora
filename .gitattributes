# Git merge strategies for branch-specific files
# This prevents conflicts when merging between main and dev branches

# Development files - keep branch-specific during merges
PRPs/** merge=ours
docs-archive/** merge=ours
test_*.py merge=ours
.claude/** merge=ours
*.md merge=ours
setup_*.sh merge=ours
examples/** merge=ours
.serena/** merge=ours
docker-historic/** merge=ours
scripts/** merge=ours
validate_*.py merge=ours
fix_*.py merge=ours
patch_*.py merge=ours
*_diarization.py merge=ours
main_pyannote.py merge=ours
torchvision_fix.py merge=ours
pyannote_fix.py merge=ours
whisper-cli.sh merge=ours
start_whisper.sh merge=ours
BRANCH_STRATEGY.md merge=ours
.env.development merge=ours
.env.production merge=ours

# Runtime files - allow merging
main.py merge=recursive
gpu_validator.py merge=recursive
sitecustomize.py merge=recursive
startup.py merge=recursive
requirements_api.txt merge=recursive
requirements_blackwell.txt merge=recursive
LICENSE merge=recursive
whisper_client.py merge=recursive